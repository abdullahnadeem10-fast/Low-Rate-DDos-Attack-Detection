* text=auto eol=lf
*.pdf binary
*.png binary
# Preserve exact generated evidence bytes for recorded SHA-256 checks.
*.csv -text whitespace=cr-at-eol
# Collection plans are hashed before traffic; preserve their exact JSON bytes.
"phase 3/plan/benign_batch_*.json" -text whitespace=cr-at-eol
# Public partition plans and their hashed JSON evidence must survive checkout.
"phase 3/plan/public_partitions_*.json" -text whitespace=cr-at-eol
"phase 3/plan/tcp_boundary_*.json" -text whitespace=cr-at-eol
"phase 3/plan/cic2019_*.json" -text whitespace=cr-at-eol
"phase 3/results/development/*.json" -text whitespace=cr-at-eol

# Stress declarations are hashed before traffic.
"phase 3/plan/benign_stress_*.json" -text whitespace=cr-at-eol

# Modelling policies are sealed before fitting.
"phase 3/plan/model_development_*.json" -text whitespace=cr-at-eol

# Blind protocol/ablation declarations are pinned byte-for-byte.
"phase 3/plan/final_ablations_*.json" -text whitespace=cr-at-eol
"phase 3/plan/blind_final_protocol_*.json" -text whitespace=cr-at-eol

# Frozen source hashes include original line endings; no code normalization.
"phase 3/src/*.py" -text whitespace=cr-at-eol
"phase 3/lab/**" -text whitespace=cr-at-eol
"phase 3/requirements*.txt" -text whitespace=cr-at-eol

# Final acquisition/qualification/evaluation evidence is hash-pinned.
"phase 3/plan/final_lab_*_acquisition_*.json" -text whitespace=cr-at-eol
"phase 3/results/qualification/*.json" -text whitespace=cr-at-eol
"phase 3/results/final/*.json" -text whitespace=cr-at-eol

# The exact-image recovery is declared before resumed traffic.
"phase 3/plan/final_lab_resolution_recovery_*.json" -text whitespace=cr-at-eol

# Reviewed unscheduled-setup declarations are sealed before resumption.
"phase 3/plan/final_lab_interruption_resume_*.json" -text whitespace=cr-at-eol
